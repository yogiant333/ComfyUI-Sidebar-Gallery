          { "path": "path", "label": "路径" },
          { "path": "filesize", "label": "大小" },
          { "path": "resolution", "label": "分辨率" },
          { "path": "generation_resolution", "label": "生成尺寸" },
          { "path": "modified", "label": "修改时间" }
        ],
        "params_video": [
          { "path": "filename", "label": "文件" },
          { "path": "path", "label": "路径" },
